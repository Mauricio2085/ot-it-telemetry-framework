        "name": "Scale from profile",
        "func": "const profilesLib = global.get('profile');\nconst item = msg.profile;\nif (!profilesLib || !item) {\n    node.warn('reading has no profile');\n    return null;\n}\nconst built = profilesLib.telemetryFromRegisters(item, msg.payload, new Date());\nif (built.error) {\n    node.warn(built.error);\n    return null;\n}\nmsg.topic = built.topic;\nmsg.payload = built.payload;\nreturn msg;",
