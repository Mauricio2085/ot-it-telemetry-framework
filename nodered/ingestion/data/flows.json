    {
        "id": "c6d5e4f3a2819071",
        "type": "function",
        "z": "a8f3e2c1b0d94e71",
        "name": "Poll profiles",
        "func": "return null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "const profilesLib = global.get('profile');\nif (!profilesLib) {\n    node.error('profile library is not loaded');\n    node.status({ fill: 'red', shape: 'ring', text: 'profile' });\n    return;\n}\nlet profiles;\ntry {\n    profiles = profilesLib.loadProfiles(env.get('PROFILE_DIR'));\n} catch (err) {\n    node.error(err.message);\n    node.status({ fill: 'red', shape: 'ring', text: 'profile' });\n    return;\n}\nconst timers = [];\nfor (const item of profiles) {\n    const start = setTimeout(() => {\n        node.send(profilesLib.pollMessage(item));\n        const tick = setInterval(() => {\n            node.send(profilesLib.pollMessage(item));\n        }, item.poll_interval_s * 1000);\n        timers.push(tick);\n    }, 2000);\n    timers.push(start);\n}\ncontext.set('timers', timers);\nnode.status({ fill: 'green', shape: 'dot', text: profiles.length + (profiles.length === 1 ? ' profile' : ' profiles') });",
        "finalize": "const timers = context.get('timers') || [];\nfor (const timer of timers) {\n    clearTimeout(timer);\n    clearInterval(timer);\n}\ncontext.set('timers', []);",
