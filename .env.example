# TimescaleDB / PostgreSQL
POSTGRES_USER=iiot
POSTGRES_PASSWORD=change_me
POSTGRES_DB=asset_health
# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me
# MQTT ingestion account: publish +/+/+/telemetry only
MQTT_INGEST_USER=ingest
MQTT_INGEST_PASSWORD=change_me
# MQTT ETL account: subscribe +/+/+/telemetry, publish rejected
MQTT_ETL_USER=etl
MQTT_ETL_PASSWORD=change_me
# Node-RED editor login inside the container (the editor port is not published) and credential encryption
NODE_RED_CREDENTIAL_SECRET=change_me
NODE_RED_ADMIN_USER=admin
NODE_RED_ADMIN_PASSWORD=change_me
# Modbus TCP (node-red-ingestion polls modbus-slave)
MODBUS_HOST=modbus-slave
MODBUS_PORT=502
MODBUS_UNIT_ID=1
